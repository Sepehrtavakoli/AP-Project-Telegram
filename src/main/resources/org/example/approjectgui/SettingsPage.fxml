<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="400.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.approjectgui.SettingsController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="400.0" style="-fx-background-color: #0088cc;">
            <children>
                <ImageView fitHeight="24.0" fitWidth="24.0" onMouseClicked="#handleBack" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                    <image>
                        <Image url="@../../../images/back_arrow_white.png" />
                    </image>
                    <HBox.margin>
                        <Insets left="15.0" />
                    </HBox.margin>
                </ImageView>
                <Label text="Settings" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                    <HBox.margin>
                        <Insets left="20.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>

        <VBox layoutY="60.0" prefWidth="400.0" spacing="20.0">
            <padding>
                <Insets top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" prefWidth="200.0" style="-fx-padding: 0 20 0 20; -fx-cursor: hand;">
                    <children>
                        <ImageView fx:id="avatarImageView" fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true">
                            <clip>
                                <Circle centerX="35.0" centerY="35.0" radius="35.0" />
                            </clip>
                        </ImageView>
                        <VBox style="-fx-padding: 0 0 0 15;">
                            <children>
                                <Label fx:id="userNameLabel" text="User Name">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Label fx:id="phoneNumberLabel" text="+1 234 567 89" textFill="#808080">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Line endX="300.0" startX="-100.0" stroke="#e0e0e0" />

                <VBox>
                    <HBox onMouseClicked="#switchToMyAccount" alignment="CENTER_LEFT" prefHeight="55.0" style="-fx-padding: 0 20 0 20; -fx-cursor: hand;">
                        <children>
                            <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../../../images/account_icon.png" />
                                </image>
                            </ImageView>
                            <Label style="-fx-padding: 0 0 0 20;" text="My Account">
                                <font>
                                    <Font size="15.0" />
                                </font>
                            </Label>
                        </children>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" prefHeight="55.0" style="-fx-padding: 0 20 0 20; -fx-cursor: hand;">
                        <children>
                            <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../../../images/notification_icon.png" />
                                </image>
                            </ImageView>
                            <Label style="-fx-padding: 0 0 0 20;" text="Notifications and Sounds">
                                <font>
                                    <Font size="15.0" />
                                </font>
                            </Label>
                        </children>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" prefHeight="55.0" style="-fx-padding: 0 20 0 20; -fx-cursor: hand;">
                        <children>
                            <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../../../images/privacy_icon.png" />
                                </image>
                            </ImageView>
                            <Label style="-fx-padding: 0 0 0 20;" text="Privacy and Security">
                                <font>
                                    <Font size="15.0" />
                                </font>
                            </Label>
                        </children>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" prefHeight="55.0" style="-fx-padding: 0 20 0 20; -fx-cursor: hand;">
                        <children>
                            <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../../../images/chat_settings_icon.png" />
                                </image>
                            </ImageView>
                            <Label style="-fx-padding: 0 0 0 20;" text="Chat Settings">
                                <font>
                                    <Font size="15.0" />
                                </font>
                            </Label>
                        </children>
                    </HBox>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
