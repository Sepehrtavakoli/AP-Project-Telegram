<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="400.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.approjectgui.ContactController">
   <children>

      <!-- Header -->
      <VBox layoutX="0.0" layoutY="0.0" prefHeight="80.0" prefWidth="400.0" style="-fx-background-color: #0088cc;">
         <children>
            <Label alignment="CENTER" prefHeight="80.0" prefWidth="400.0" text="Contacts" textFill="WHITE">
               <font>
                  <Font name="Arial Rounded MT Bold" size="24.0" />
               </font>
               <padding>
                  <Insets top="20.0" />
               </padding>
            </Label>
         </children>
      </VBox>

      <!-- Back Button -->
      <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="15.0" layoutY="25.0" onMouseClicked="#BackArrow" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
         <image>
            <Image url="@../../../images/back_arrow_white.png" />
         </image>
      </ImageView>

      <!-- Action Buttons -->
      <VBox layoutX="20.0" layoutY="100.0" spacing="0.0" prefWidth="360.0">

         <!-- New Contact -->
         <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="360.0" style="-fx-cursor: hand;" onMouseClicked="#SwitchToNewContactPage">
            <children>
               <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../../images/add_contact.png" />
                  </image>
               </ImageView>
               <Label text="New Contact" style="-fx-padding: 0 0 0 15;">
                  <font>
                     <Font size="16.0" />
                  </font>
               </Label>
            </children>
         </HBox>
         <Line endX="360.0" startX="0.0" stroke="#e0e0e0" strokeWidth="1.0" />

         <!-- New Group -->
         <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="360.0" style="-fx-cursor: hand;">
            <children>
               <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../../images/add_group.png" />
                  </image>
               </ImageView>
               <Label text="New Group" style="-fx-padding: 0 0 0 15;">
                  <font>
                     <Font size="16.0" />
                  </font>
               </Label>
            </children>
         </HBox>
         <Line endX="360.0" startX="0.0" stroke="#e0e0e0" strokeWidth="1.0" />

         <!-- New Channel -->
         <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="360.0" style="-fx-cursor: hand;">
            <children>
               <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../../images/add_channel.png" />
                  </image>
               </ImageView>
               <Label text="New Channel" style="-fx-padding: 0 0 0 15;">
                  <font>
                     <Font size="16.0" />
                  </font>
               </Label>
            </children>
         </HBox>
         <Line endX="360.0" startX="0.0" stroke="#e0e0e0" strokeWidth="1.0" />

      </VBox>

      <!-- Contacts Header -->
      <Label layoutX="20.0" layoutY="280.0" text="Contacts" textFill="#0088cc">
         <font>
            <Font name="Arial Bold" size="18.0" />
         </font>
      </Label>

      <!-- Contacts List -->
      <VBox fx:id="contactsList" layoutX="0.0" layoutY="310.0" prefHeight="290.0" prefWidth="400.0" spacing="0.0" />

   </children>
</AnchorPane>