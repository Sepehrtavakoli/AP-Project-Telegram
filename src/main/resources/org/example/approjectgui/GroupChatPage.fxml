<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.control.Button?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.approjectgui.GroupChatController">
    <VBox prefHeight="600.0" prefWidth="400.0" style="-fx-background-color: #f0f0f0;">
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: #0088cc; -fx-padding: 10;">
            <Button text="←" onMouseClicked="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 18; -fx-cursor: hand;"/>
            <VBox spacing="2.0" style="-fx-padding: 0 0 0 10;">
                <Label fx:id="groupNameLabel" text="Group Name" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <HBox spacing="5.0">
                    <Circle fx:id="onlineIndicator" radius="5.0" fill="LIMEGREEN"/>
                    <Label fx:id="memberCountLabel" text="5 members" style="-fx-text-fill: lightgray; -fx-font-size: 12px;"/>
                </HBox>
            </VBox>
        </HBox>

        <!-- Messages Area -->
        <ScrollPane fx:id="scrollPane" fitToWidth="true" vvalue="1.0" VBox.vgrow="ALWAYS">
            <VBox fx:id="messagesContainer" spacing="5.0" style="-fx-padding: 10;"/>
        </ScrollPane>

        <!-- Input Area -->
        <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-padding: 10;">
            <Button text="📎" onMouseClicked="#handleAttachFile" style="-fx-background-color: transparent; -fx-font-size: 18; -fx-cursor: hand;"/>
            <TextField fx:id="messageInput" promptText="Type a message..." HBox.hgrow="ALWAYS" style="-fx-background-radius: 20; -fx-padding: 8;"/>
            <Button text="➤" onMouseClicked="#sendMessage" style="-fx-background-color: #0088cc; -fx-text-fill: white; -fx-font-size: 16; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 8 15 8 15;"/>
        </HBox>
    </VBox>
</AnchorPane>