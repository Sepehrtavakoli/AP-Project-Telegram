<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="500.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.approjectgui.NewContactController">
   <children>
      <!-- Header with Telegram-like style -->
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#4c90cf" height="55.0" stroke="TRANSPARENT" strokeType="INSIDE" width="400.0" />
      <Label layoutX="145.0" layoutY="14.0" text="New Contact" textFill="WHITE">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>

      <!-- Back Button -->
      <ImageView fx:id="BackArrow" fitHeight="40.0" fitWidth="32.0" layoutX="14.0" layoutY="12.0" onMouseClicked="#BackArrow" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../images/arrow.png" />
         </image>
      </ImageView>

      <!-- Content Area -->
      <VBox layoutX="20.0" layoutY="69.0" prefHeight="426.0" prefWidth="360.0" spacing="20.0">
         <!-- Profile Section with Circle on left and names on right -->
         <HBox alignment="CENTER_LEFT" spacing="20.0">
            <!-- Circle on the left -->
            <StackPane>
               <Circle fill="#4c90cf" radius="40.0" stroke="#d3d3d3" strokeType="INSIDE" />
               <Label fx:id="firstLetter" textFill="WHITE">
                  <font>
                     <Font size="28.0" />
                  </font>
               </Label>
            </StackPane>

            <!-- Name fields on the right -->
            <VBox prefWidth="240.0" spacing="10.0">
               <Label text="First Name">
                  <font>
                     <Font size="13.0" />
                  </font>
               </Label>
               <TextField fx:id="firstNameTextField" prefHeight="40.0" prefWidth="240.0" style="-fx-background-radius: 5; -fx-border-radius: 5;" />

               <Label layoutY="10.0" text="Last Name">
                  <font>
                     <Font size="13.0" />
                  </font>
               </Label>
               <TextField fx:id="lastNameTextField" prefHeight="40.0" prefWidth="240.0"
                          style="-fx-background-radius: 5; -fx-border-radius: 5;" />
            </VBox>
         </HBox>

         <!-- Phone Numbers Section -->
         <VBox fx:id="phoneContainer" prefHeight="143.0" prefWidth="360.0" spacing="10.0">
            <Label text="Phone Numbers">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>

            <!-- Phone 1 -->
            <HBox spacing="5.0">
               <ChoiceBox fx:id="NumType1" prefHeight="40.0" prefWidth="100.0" style="-fx-background-radius: 5 0 0 5;" />
               <TextField fx:id="Phone1" prefHeight="40.0" prefWidth="255.0" style="-fx-background-radius: 0 5 5 0; -fx-border-radius: 0 5 5 0;" />
            </HBox>

            <!-- Phone 2 (initially hidden) -->
            <HBox fx:id="phone2Container" managed="false" spacing="5.0" visible="false">
               <ChoiceBox fx:id="NumType2" prefHeight="40.0" prefWidth="100.0" style="-fx-background-radius: 5 0 0 5;" />
               <TextField fx:id="Phone2" prefHeight="40.0" prefWidth="255.0" style="-fx-background-radius: 0 5 5 0; -fx-border-radius: 0 5 5 0;" />
            </HBox>

            <!-- Phone 3 (initially hidden) -->
            <HBox fx:id="phone3Container" managed="false" spacing="5.0" visible="false">
               <ChoiceBox fx:id="NumType3" prefHeight="40.0" prefWidth="100.0" style="-fx-background-radius: 5 0 0 5;" />
               <TextField fx:id="Phone3" prefHeight="40.0" prefWidth="255.0" style="-fx-background-radius: 0 5 5 0; -fx-border-radius: 0 5 5 0;" />
            </HBox>

            <!-- Add Phone Button -->
            <Button fx:id="addPhoneButton" mnemonicParsing="false" onAction="#addPhoneField" prefHeight="30.0" prefWidth="360.0" style="-fx-background-color: transparent; -fx-text-fill: #4c90cf; -fx-border-color: #4c90cf; -fx-border-radius: 5;" text="+ Add Phone">
               <font>
                  <Font size="12.0" />
               </font>
            </Button>
         </VBox>

         <!-- Alert Label -->
         <Label fx:id="AlertLabel" textFill="RED" />

         <!-- Create Button -->
         <Button fx:id="CreatNewContact" mnemonicParsing="false" onAction="#createNewContact" prefHeight="45.0" prefWidth="360.0" style="-fx-background-color: #4c90cf; -fx-background-radius: 20;" text="Create New Contact" textFill="WHITE">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
      </VBox>
   </children>
</AnchorPane>
